# Get your key at https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
PORT=3000

# Supabase
SUPABASE_URL=https://fuqpgtyuuzegycnazdxv.supabase.co
