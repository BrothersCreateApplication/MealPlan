# Google Gemini API Key (dùng cho tất cả AI features — thay thế hoàn toàn DeepSeek)
# Get free key at https://aistudio.google.com/apikey (no credit card needed, 1500 req/day free)
# GEMINI_API_KEY vừa dùng cho text vừa dùng cho vision (Gemini Flash)
GEMINI_API_KEY=your_gemini_api_key_here
PORT=3000

# Supabase
SUPABASE_URL=https://fuqpgtyuuzegycnazdxv.supabase.co
# Get service role key at https://supabase.com/dashboard/project/fuqpgtyuuzegycnazdxv/settings/api-keys
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Unsplash Access Key (tùy chọn — cho ảnh món ăn)
# Get key at https://unsplash.com/oauth/applications
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here
